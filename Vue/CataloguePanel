package vue;

import model.Produit;
import javax.swing.*;
import java.awt.*;
import java.util.List;

public class CataloguePanel extends JPanel {
    private JTable table;
    private ProduitTableModel tableModel;

    public CataloguePanel(List<Produit> produits) {
        setLayout(new BorderLayout());
        tableModel = new ProduitTableModel(produits);
        table = new JTable(tableModel);
        add(new JScrollPane(table), BorderLayout.CENTER);
    }

    public void updateCatalogue(List<Produit> produits) {
        tableModel.setProduits(produits);
        tableModel.fireTableDataChanged();
    }
}
